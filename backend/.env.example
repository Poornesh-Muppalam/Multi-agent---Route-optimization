# RouteMind backend — Phase 2 agent config.
# Copy this file to `.env`, paste your key, then start the backend with:
#   uvicorn app:app --reload --port 8000 --env-file .env

# ---------------------------------------------------------------------------
# LLM for the chat + agent narration. Provider-agnostic: any OpenAI-compatible
# endpoint works. Without any key set, the app still runs fully (the chat uses
# its rule-based parser, agents use computed/template text).
#
# FREE option A — Groq (fast, generous free tier). Get a key at console.groq.com:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_groq_key
#   LLM_MODEL=llama-3.3-70b-versatile
#
# FREE option B — Google Gemini (OpenAI-compatible endpoint). Key at aistudio.google.com:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=your_gemini_key
#   LLM_MODEL=gemini-2.0-flash
#
# Local, no key, no cost — Ollama (run `ollama serve` + `ollama pull llama3.1`):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Legacy: Anthropic (used only if the LLM_* vars above are not set).
ANTHROPIC_API_KEY=
ROUTEMIND_MODEL=claude-haiku-4-5

# Routing: by default RouteMind fetches REAL road distances and drive times
# from the public OSRM server (free, no key, but not live traffic). Point this
# at your own OSRM instance in production, or set ROUTEMIND_ROUTING=off to fall
# back to the straight-line estimate.
OSRM_URL=https://router.project-osrm.org
# ROUTEMIND_ROUTING=osrm   # set to "off" to disable road routing
