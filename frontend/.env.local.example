# Where the Python backend is running.
# For local development this is the default below.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional: n8n Cloud webhook that acts as the chat "brain". When set, chat
# messages are interpreted by the n8n workflow (see routemind/n8n/); edits are
# still applied + re-solved by the backend. Leave blank to use the built-in
# backend /chat endpoint. Use the workflow's PRODUCTION webhook URL.
# e.g. https://<your-subdomain>.app.n8n.cloud/webhook/routemind-chat
NEXT_PUBLIC_N8N_CHAT_URL=

# Google Maps API key (required for the map). Create one in Google Cloud with
# billing enabled, and enable: Maps JavaScript API, Directions API,
# Places API, and Geocoding API. Restrict the key to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
